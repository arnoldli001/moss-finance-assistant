# ===========================================
# MOSS Finance Assistant - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================

# ---------- RAGFlow 知识库服务 ----------
RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_CLIENT_ID=your-ragflow-client-id

# ---------- LLM 大模型配置 ----------
# 使用 OpenAI 兼容协议，可接入通义千问、DeepSeek、OpenAI 等
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="your-openai-or-deepseek-api-key"

# 模型名称（根据你的服务商填写）
DEEPSEEK_V4_FLASH=deepseek-v4-flash
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY="your-tavily-api-key"

# ---------- MySQL 数据库 ----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---------- 知识星球 zsxq（可选）----------
# 获取方式：浏览器登录 https://wx.zsxq.com 后，
# F12 -> Application -> Cookies -> 复制 zsxq_access_token 的值
ZSXQ_ACCESS_TOKEN=""
# 默认群组ID（URL 末段即为群组ID）
ZSXQ_GROUP_ID=488484411448
# 请求间隔(秒)，防止风控
ZSXQ_REQUEST_INTERVAL=1.5

# ---------- ngrok 公网隧道（可选）----------
# 配置后启动时自动创建公网隧道，手机可远程访问
# 使用前提：已安装 pyngrok →  python -m pip install pyngrok==8.1.2
# 若未安装 pyngrok 但配置了此变量，启动时会打印安装提示并自动跳过，不影响局域网访问

# ---------- 记忆管理 Context Engineering（可选）----------
# 滑动窗口：完整保留最近 N 轮对话（超过部分进入摘要压缩流程）
MEM_WINDOW_KEEP_LAST_N=10
# 超过多少轮触发摘要压缩（旧对话会被压缩成 3 段摘要：早期/中期/近期）
MEM_SUMMARY_TRIGGER_TURNS=20
# 压缩后的摘要段数（默认 3，值越大粒度越细但占用上下文越多）
MEM_SUMMARY_SEGMENTS=3
# 单段摘要最大字符数（防止单段过长）
MEM_SUMMARY_MAX_CHARS_PER_SEG=800
# 关键决策永久保留的最大条数（防止无限膨胀：股票代码/买入卖出/财报结论等会被归入关键决策）
MEM_KEY_DECISION_MAX_KEEP=50
# 历史对话相关度阈值（0.0-1.0）：低于此值的历史对话不放入 context，减少 token 消耗
MEM_RELEVANCE_THRESHOLD=0.15
# 最多保留几条相关历史对话（过滤后上限）
MEM_MAX_RELEVANT_TURNS=6

# ---------- 渐进式工具披露 Progressive Tool Disclosure（可选）----------
# 全局开关：1=启用两阶段路由节省Tool Schema Token；0=关闭回退全量暴露
PTD_ENABLED=1
# 路由阶段最多允许选几个工具（防止模型又把全部选回来）
PTD_MAX_TOOLS_PER_ROUND=4
# 兜底披露最多追加几次工具（防循环：模型选不到时自动补，超过后直接放弃返回错误）
PTD_MAX_FALLBACK_DISCLOSURES=2

# ---------- Layer2: Context Engineering 精简裁剪（可选）----------
# 记忆/检索上下文超过多少字时触发按问题关联度裁剪（默认2000）
CONTEXT_MAX_CHARS=2000

# ---------- Layer3: Trace 可观测性（可选）----------
# 全局开关：1=记录每轮完整trace到data/trace.db；0=关闭（节省磁盘IO）
TRACE_ENABLED=1

# ---------- Layer4: 定时调度器（可选）----------
# 全局开关：1=启用盘前自动化心跳（工作日9:13小作文/9:15新闻）；0=关闭
SCHEDULER_ENABLED=1
# 时区偏移（默认8=UTC+8中国时区）
SCHEDULER_TZ_OFFSET=8

# ---------- P0 鉴权/限流（P0 修复：后端 JWT + RBAC 4 档 QPM 限流）----------
# JWT 签名密钥：生产环境必须显式设置；默认每次启动用 secrets.token_urlsafe(48) 随机，
#   一旦重启所有已发出的 JWT 立即失效（用户被强制退出）。
#   生成密钥命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=粘贴生成结果

# JWT access_token 过期时间（分钟，默认 120 = 2 小时）
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 默认 owner 账号 user_id：首次 init_db() 时自动将该 user_id 角色升为 owner
#   owner = 600 QPM + 全部运维端点（scheduler/slo/circuit-breakers/traces 全量）权限
# MOSS_DEFAULT_OWNER_USER_ID=moss_admin
