# ===========================================
# MOSS Finance Assistant - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================

# ---------- RAGFlow 知识库服务 ----------
RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_CLIENT_ID=your-ragflow-client-id

# ---------- LLM 大模型配置 ----------
# 使用 OpenAI 兼容协议，可接入通义千问、DeepSeek、OpenAI 等
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="your-openai-or-deepseek-api-key"

# 模型名称（根据你的服务商填写）
DEEPSEEK_V4_FLASH=deepseek-v4-flash
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY="your-tavily-api-key"

# ---------- MySQL 数据库 ----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---------- 知识星球 zsxq（可选）----------
# 获取方式：浏览器登录 https://wx.zsxq.com 后，
# F12 -> Application -> Cookies -> 复制 zsxq_access_token 的值
ZSXQ_ACCESS_TOKEN=""
# 默认群组ID（URL 末段即为群组ID）
ZSXQ_GROUP_ID=488484411448
# 请求间隔(秒)，防止风控
ZSXQ_REQUEST_INTERVAL=1.5

# ---------- ngrok 公网隧道（可选）----------
# 配置后启动时自动创建公网隧道，手机可远程访问
# NGROK_AUTHTOKEN=your-ngrok-authtoken
